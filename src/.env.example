# Copie para .env e ajuste. Todas as variáveis são opcionais em desenvolvimento.

# Banco: SQLite em arquivo (padrão) ou PostgreSQL.
COCHEF_DB_URL=sqlite:///dados/cochef.db
# COCHEF_DB_URL=postgresql+psycopg://cochef:cochef@localhost:5432/cochef

# Segredo do token (mínimo 32 caracteres). Se ficar vazio, um segredo é gerado e guardado em dados/.segredo-jwt.
# Em produção, defina sempre.
# COCHEF_JWT_SEGREDO=troque-por-um-texto-aleatorio-bem-longo-com-32-ou-mais

PORT=3000
COCHEF_FUSO=America/Sao_Paulo
COCHEF_BCRYPT_CUSTO=12
COCHEF_TOKEN_SEGUNDOS=86400
COCHEF_LIMITE_AUTH=10
COCHEF_JANELA_AUTH_SEGUNDOS=60
